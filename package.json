{
  "name": "cordly-packages",
  "version": "0.0.0",
  "private": true,
  "description": "Cordly shared frontend foundations: design tokens, accessible Angular primitives, and domain-neutral composed widgets, published as independently versioned packages.",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.2",
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tokens:build": "node packages/tokens/tools/build-tokens.mjs",
    "tokens:check": "node packages/tokens/tools/build-tokens.mjs --check",
    "tokens:test": "node --test packages/tokens/test/*.test.mjs",
    "build": "npm run tokens:check && npm run build:ui && npm run build:widgets",
    "build:ui": "ng build ui",
    "build:widgets": "ng build widgets",
    "test": "ng test ui && ng test widgets",
    "files:check": "node tools/check-component-files.mjs",
    "api:extract": "node tools/check-api.mjs --write",
    "api:check": "node tools/check-api.mjs",
    "pack:all": "node tools/pack.mjs",
    "package:check": "node tools/check-packages.mjs",
    "hygiene:check": "node tools/check-hygiene.mjs",
    "verify": "npm run format:check && npm run lint && npm run files:check && npm run hygiene:check && npm run tokens:check && npm run tokens:test && npm run build && npm run test && npm run api:check && npm run pack:all && npm run package:check",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/compiler-cli": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "22.1.4",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "angular-eslint": "22.2.0",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "ng-packagr": "22.1.1",
    "prettier": "3.9.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
